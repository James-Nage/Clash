# ========================
# Clash-ALL 优化配置
# ========================

# 机场节点订阅

proxy-providers:

  KTM 机场:
    url: "https://"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    proxy: 直连 

  翻墙机场:
    url: "https://
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    proxy: 直连 
    
  红杏机场:
    url: "https://"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    proxy: 直连 



proxies:
  - {name: 直连, type: direct}
  - {name: 拒绝, type: reject}

# ========================
# 主要端口设置
# ========================
port: 7890
socks-port: 7891
redir-port: 7892
mixed-port: 7893
tproxy-port: 7895

allow-lan: true
mode: rule
log-level: info

external-controller: 0.0.0.0:9090
# external-ui: ui
# external-ui-name: zashboard
# external-ui-url: https://gh-proxy.com/github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip
secret: "123456"

# ========================
# DNS 设置
# ========================
dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.20.0.1/16
  nameserver:
    - 223.5.5.5
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - +.lan
    - +.local
    - geosite:cn
# 机场    
    - +.翻墙机场.com
    - +.hongxingyun.club
    - +.ktmgroup-host.com
    - +.ktmcloud.net
    - +.ktm.ooo


ipv6: true

# ========================
# TUN 模块
# ========================
tun:
  enable: true
  stack: gvisor
  device: utun
  endpoint-independent-nat: true
  auto-route: false
  auto-detect-interface: false
  auto-redirect: false
  strict-route: false

profile:
  store-selected: true
  store-fake-ip: true
 

# ========================
# 策略组定义
# ========================
default: &default
  type: select
  proxies:
    - 所有-手动
    - 所有-自动
    - 香港-故转
    - 台湾-故转
    - 日本-故转
    - 新加坡-故转
    - 影视-故转
    - 美国-故转
    - 其他-故转
    - 拒绝
    - 直连

proxy-groups:

  # 业务分流组
  
  - {name: ChatGPT, <<: *default}
  - {name: Emby, <<: *default}
  - {name: Meta AI, <<: *default}
  - {name: GitHub, <<: *default}
  - {name: Telegram, <<: *default}
  - {name: WhatsApp, <<: *default}
  - {name: Facebook, <<: *default}
  - {name: BiliBili, <<: *default}
  - {name: YouTube, <<: *default}
  - {name: TikTok, <<: *default}
  - {name: Spotify, <<: *default}
  - {name: Steam, <<: *default}
  - {name: Games, <<: *default}
  - {name: Apple, <<: *default}
  - {name: Google, <<: *default}
  - {name: Microsoft, <<: *default}
  - {name: Block, <<: *default}
  - {name: 国外, <<: *default}
  - {name: 国内, <<: *default}
  - {name: 其他, <<: *default}

  - name: 所有-手动
    type: select
    include-all: true
    filter: "^((?!(直连|拒绝)).)*$"

  - name: 所有-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "^((?!(直连|拒绝)).)*$"

  # 香港组
  - name: 香港-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 香港-手动
      - 香港-自动
  
  - name: 香港-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(HK)).*$"
    
  - name: 香港-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(HongKong|香港IEPL|香港直连)).*$"
 
  # 台湾组
  - name: 台湾-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 台湾-手动
      - 台湾-自动
      
  - name: 台湾-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(TW)).*$"
    
  - name: 台湾-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(台湾直连|台湾IEPL)).*$"

  # 日本组
  - name: 日本-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 日本-手动
      - 日本-自动
      
  - name: 日本-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(JP)).*$"
    
  - name: 日本-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(Tokyo|日本直连|日本IEPL)).*$"

  # 新加坡组
  - name: 新加坡-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 新加坡-手动
      - 新加坡-自动
      
  - name: 新加坡-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(SG)).*$"
    
  - name: 新加坡-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(Singapore|新加坡IEPL|新加坡直连)).*$"

  # 影视组
  - name: 影视-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 影视-手动
      - 影视-自动
      
  - name: 影视-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(HK|TW|SG|USA|JP|DE|AU|VN)).*$"
    
  - name: 影视-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(香港直连|日本直连|美国直连|新加坡直连|台湾直连|韩国|IEPL|Hong|Inch|Sin)).*$"

  # 美国组
  - name: 美国-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 美国-手动
      - 美国-自动
      
  - name: 美国-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(USA)).*$"
    
  - name: 美国-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(California|美国IEPL|美国直连)).*$"

  # 其他组
  - name: 其他-故转
    type: fallback
    interval: 300
    lazy: false
    proxies:
      - 其他-手动
      - 其他-自动
      
  - name: 其他-手动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "(?=.*(IN|VN|AU|DE|UK|法国|DE|CA)).*$"
    
  - name: 其他-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 300
    filter: "^((?!(直连|拒绝|香|新|日|台|美|韩|Hong|To|Si|Ca|In)).)*$"

