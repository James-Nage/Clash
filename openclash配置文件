# ========================
# Clash-ALL 优化配置
# ========================
# 机场节点订阅
proxy-providers:
  KTM 机场:
    url: "、3"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    proxy: 直连  
    
  良心云机场:
    url: "h、a5"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    proxy: 直连 
proxies:
  - {name: 直连, type: direct}
  - {name: 拒绝, type: reject}
  
# ========================
# 主要端口设置
# ========================
port: 7890
socks-port: 7891
redir-port: 7892
mixed-port: 7893
tproxy-port: 7895
allow-lan: true
mode: rule
log-level: info
external-controller: 0.0.0.0:9090
# external-ui: ui
# external-ui-name: zashboard
# external-ui-url: https://gh-proxy.com/github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip
secret: "123456"
# ========================
# DNS 设置
# ========================
dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.20.0.1/16
  nameserver:
    - 223.5.5.5
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - +.lan
    - +.local
    - geosite:cn
# 机场    
    - +.翻墙机场.com
    - +.hongxingyun.club
    - +.ktmgroup-host.com
    - +.ktmcloud.net
    - +.ktm.ooo
ipv6: true
# ========================
# TUN 模块
# ========================
tun:
  enable: true
  stack: gvisor
  device: utun
  endpoint-independent-nat: true
  auto-route: false
  auto-detect-interface: false
  auto-redirect: false
  strict-route: false
profile:
  store-selected: true
  store-fake-ip: true
 
# ========================
# 策略组定义
# ========================
default: &default
  type: select
  proxies:
    - 所有-手动
    - 所有-自动
    - 香港-故转
    - 台韩-故转
    - 日本-故转
    - 新加坡-故转
    - 影视-故转
    - 美国-故转
    - 其他-故转
    - 拒绝
    - 直连
proxy-groups:
  # 业务分流组
  - {name: ChatGPT, <<: *default}
  - {name: Emby, <<: *default}
  - {name: Meta AI, <<: *default}
  - {name: GitHub, <<: *default}
  - {name: Telegram, <<: *default}
  - {name: WhatsApp, <<: *default}
  - {name: Facebook, <<: *default}
  - {name: BiliBili, <<: *default}
  - {name: YouTube, <<: *default}
  - {name: TikTok, <<: *default}
  - {name: Spotify, <<: *default}
  - {name: Steam, <<: *default}
  - {name: Games, <<: *default}
  - {name: Apple, <<: *default}
  - {name: Google, <<: *default}
  - {name: Microsoft, <<: *default}
  - {name: Block, <<: *default}
  - {name: 国外, <<: *default}
  - {name: 国内, <<: *default}
  - {name: 其他, <<: *default}
  
  - name: 所有-手动
    type: select
    include-all: true
    filter: "^((?!(直连|拒绝)).)*$"
    
  - name: 所有-自动
    type: url-test
    include-all: true
    tolerance: 50
    interval: 150
    filter: "^((?!(直连|拒绝)).)*$"
    
  # 香港组
  - name: 香港-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 香港-良心
      - 香港-KTM
  
  - name: 香港-KTM
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(HK|Hong)).*$"
    
  - name: 香港-良心
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(香港高|香港专|Hong)).*$"
 
  # 台湾组
  - name: 台韩-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 台韩-良心
      - 台韩-KTM
      
  - name: 台韩-KTM
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(TW|In|KR)).*$"
    
  - name: 台韩-良心
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(台湾高|台湾专|韩国专|韩国高|In)).*$"
    
  # 日本组
  - name: 日本-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 日本-良心
      - 日本-KTM
      
  - name: 日本-KTM
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(To|JP)).*$"
    
  - name: 日本-良心
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(日本专|日本高)).*$"

  # 新加坡组
  - name: 新加坡-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 新加坡-良心
      - 新加坡-KTM
      
  - name: 新加坡-KTM
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(SG|Sin|新加坡0)).*$"
    
  - name: 新加坡-良心
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(新加坡高|新加坡专)).*$"

# 影视组
  - name: 影视-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 香港-稳健
      - 日本-飞越
      - 新加坡-终点
      - 美国-瑟瑟
      
  - name: 香港-稳健
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(香)).*$"
    url: "https://m.wenjian.de"
    fallback-status: "200,301,302,307,308"
    
  - name: 日本-飞越
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(日本)).*$"
    url: "https://fych.feiyue.lol"
    fallback-status: "200,301,302,307,308"
    
  - name: 新加坡-终点
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(新加)).*$"
    url: "https://c.emby.wtf"
    fallback-status: "200,301,302,307,308"

  - name: 美国-瑟瑟
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(美)).*$" 
    url: "https://emby.heisi.org"
    fallback-status: "200,301,302,307,308"
      
  # 美国组
  - name: 美国-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 美国-良心
      - 美国-KTM
      
  - name: 美国-KTM
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(USA|Ca)).*$"
    
  - name: 美国-良心
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(美国专|美国高|Ca)).*$"
  
  # 其他组
  - name: 其他-故转
    type: fallback
    interval: 120
    lazy: false
    proxies:
      - 其他-良心
      - 其他-KTM
      
  - name: 其他-KTM
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(MY|印度|2028|TH|AU|IN|CA|UK|DE|FR)).*$"
    
  - name: 其他-良心
    type: url-test
    include-all: true
    tolerance: 50
    interval: 60
    filter: "(?=.*(英国伦敦|2029|2026)).*$"
# ========================
# 规则引擎（rules）
# ========================
rules:
#
# 规则分流说明：
# PROCESS-NAME,curl,DIRECT #匹配路由自身进程(curl直连)
# DOMAIN-SUFFIX,google.com,Proxy #匹配域名后缀(交由Proxy代理服务器组)
# DOMAIN-KEYWORD,google,Proxy #匹配域名关键字(交由Proxy代理服务器组)
# DOMAIN,google.com,Proxy #匹配域名(交由Proxy代理服务器组)
# DOMAIN-SUFFIX,ad.com,REJECT #匹配域名后缀(拒绝)
# IP-CIDR,127.0.0.0/8,DIRECT #匹配数据目标IP(直连)
# SRC-IP-CIDR,192.168.1.201/32,DIRECT #匹配数据发起IP(直连)
# DST-PORT,80,DIRECT #匹配数据目标端口(直连)
# SRC-PORT,777,DIRECT #匹配数据源端口(直连)
# GEOSITE,category-public-tracker,DIRECT #匹配GEOSITE数据库规则(直连)
# DOMAIN-REGEX,^abc.*com,PROXY #正则匹配域名
# RULE-SET,providername,PROXY #匹配规则集 
# EMBY说明 ：emby.wtf用SG，wenjian.de用USA，feiyue.lol用HK，emby.heisi.org用JP
  - DOMAIN,m.wenjian.de,香港-稳健
  - DOMAIN-KEYWORD,feiyue,日本-飞越
  - DOMAIN-KEYWORD,hongxing,新加坡-终点
  - DOMAIN-SUFFIX,emby.wtf,新加坡-终点
  - DOMAIN-SUFFIX,heisi.org,美国-瑟瑟
  - IP-CIDR,100.66.0.0/16,国内
  - RULE-SET,Block / Domain,Block
  - DOMAIN-KEYWORD,qiyunle,国内
  - DOMAIN-KEYWORD,txffp,国内
  - DOMAIN-KEYWORD,txrui,国内
  - DOMAIN-KEYWORD,ccccltd,国内
  - DOMAIN-KEYWORD,npmmirror,国内
  - DOMAIN-KEYWORD,ipify,国内
  # NTP 直连
  - DST-PORT,123,直连 #匹配数据目标端口(直连)
  - SRC-PORT,123,直连 #匹配数据源端口(直连)
  - DOMAIN-SUFFIX,ip.sb,国内
  - DOMAIN-KEYWORD,jsdelivr,国内
  - RULE-SET,ChatGPT / Domain,ChatGPT
  - RULE-SET,Meta AI / Domain,Meta AI
  - RULE-SET,Emby / Domain,Emby
  - RULE-SET,GitHub / Domain,GitHub
  - RULE-SET,Telegram / Domain,Telegram
  - RULE-SET,Telegram / IP,Telegram
  - RULE-SET,WhatsApp / Domain,WhatsApp
  - RULE-SET,Facebook / Domain,Facebook
  - RULE-SET,Apple / Domain,Apple
  - RULE-SET,Apple-CN / Domain,Apple  
  - RULE-SET,Apple-Custome / Domain,Apple  
  - RULE-SET,Microsoft / Domain,Microsoft
  - RULE-SET,BiliBili / Domain,BiliBili
  - RULE-SET,Youtube / Domain,YouTube
  - RULE-SET,TikTok / Domain,TikTok
  - RULE-SET,Spotify / Domain,Spotify
  - RULE-SET,Steam / Domain,Steam
  - RULE-SET,Epic / Domain,Games
  - RULE-SET,EA / Domain,Games
  - RULE-SET,Blizzard / Domain,Games
  - RULE-SET,UBI / Domain,Games
  - RULE-SET,PlayStation / Domain,Games
  - RULE-SET,Nintend / Domain,Games
  - RULE-SET,Google / Domain,Google
  - RULE-SET,Google / IP,Google,no-resolve
  - RULE-SET,Proxy / Domain,国外
  - RULE-SET,Globe / Domain,国外  
  - RULE-SET,Direct / Domain,国内
  - RULE-SET,China / Domain,国内
  - RULE-SET,China / IP,国内,no-resolve
  - RULE-SET,Private / Domain,国内
  - MATCH,其他
